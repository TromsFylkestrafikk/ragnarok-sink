{
    "name": "ragnarok/sink",
    "description": "Sink API for Ragnarok",
    "type": "library",
    "homepage": "https://github.com/tromsfylkestrafikk/ragnarok-sink",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "library"
    ],
    "authors": [
        {
            "name": "Kåre Slettnes",
            "email": "kaare.slettnes@tromsfylke.no"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "league/csv": "^9.16.0",
        "league/flysystem": "^3.8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "^2.1.14",
        "larastan/larastan": "^3.4",
        "orchestra/testbench": "^10.2",
        "orchestra/canvas": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ragnarok\\Sink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ragnarok\\Sink\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ragnarok\\Sink\\SinkServiceProvider"
            ]
        }
    }
}
